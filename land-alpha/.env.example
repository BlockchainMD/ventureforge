# ============================================================================
# Land Alpha — environment
#
# The only required variable is DATABASE_URL. Every integration below is
# optional and degrades to a documented fixture mode, so `pnpm setup && pnpm dev`
# gives you the whole product with no API keys.
#
# Copy to .env and edit. Never commit .env.
# ============================================================================

# ---- Required --------------------------------------------------------------
# PostgreSQL 14+ with the PostGIS extension available.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/landalpha?schema=public"

# Used only by `prisma migrate dev` to verify migrations against a clean schema.
SHADOW_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/landalpha_shadow?schema=public"

NODE_ENV=development

# ---- Sessions --------------------------------------------------------------
# 32+ characters. REQUIRED in production; generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=""
SESSION_TTL_HOURS=12

# ---- Job queue -------------------------------------------------------------
# Leave REDIS_URL unset to use the Postgres-backed queue (the default; no extra
# infrastructure). Set it to switch to BullMQ for horizontal workers.
# REDIS_URL="redis://localhost:6379"
# QUEUE_DRIVER="postgres"   # or "bullmq"; inferred from REDIS_URL when unset
WORKER_CONCURRENCY=4

# ---- Object storage --------------------------------------------------------
# Raw source artefacts (the exact bytes we parsed), generated reports and
# marketing assets. Filesystem locally; any S3-compatible endpoint in production.
STORAGE_DRIVER=filesystem
STORAGE_LOCAL_DIR=./data/storage
# STORAGE_DRIVER=s3
# S3_ENDPOINT="https://s3.us-east-1.amazonaws.com"
# S3_REGION="us-east-1"
# S3_BUCKET="land-alpha-artifacts"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_FORCE_PATH_STYLE=true

# ---- AI --------------------------------------------------------------------
# "fixture" needs no credentials and generates memos and listings
# deterministically from structured data. AI is never the sole authority for
# title, access, buildability, zoning, environment or valuation, so fixture mode
# produces the same figures — just without the prose.
AI_PROVIDER=fixture           # fixture | anthropic | openai
# ANTHROPIC_API_KEY=""
# OPENAI_API_KEY=""
AI_MODEL_REASONING="claude-opus-4-5"
AI_MODEL_FAST="claude-sonnet-4-5"
AI_MAX_OUTPUT_TOKENS=4096
AI_TEMPERATURE=0.2

# ---- Ingestion politeness --------------------------------------------------
# These govern how Land Alpha behaves toward government servers. Identify
# yourself honestly and give a contact address that a county webmaster can
# actually reach.
INGEST_USER_AGENT="LandAlphaBot/0.1 (+https://landalpha.example/bot; contact@landalpha.example)"
INGEST_CONTACT_EMAIL="contact@landalpha.example"
INGEST_MIN_DELAY_MS=1500          # minimum delay between requests to one host
INGEST_MAX_REQUESTS_PER_RUN=600   # hard cap per ingestion run
INGEST_TIMEOUT_MS=45000
INGEST_RESPECT_ROBOTS=true        # do not change this
INGEST_OFFLINE=false              # true reads recorded fixtures instead of the network

# ---- Environmental enrichment ----------------------------------------------
# "fixture" does not call federal services; parcels keep whatever was previously
# recorded. "live" queries FEMA, USFWS, EPA, USDA and USGS directly.
ENRICHMENT_MODE=fixture           # fixture | live
FEMA_NFHL_URL="https://hazards.fema.gov/arcgis/rest/services/public/NFHL/MapServer"
USFWS_WETLANDS_URL="https://www.fws.gov/wetlandsmapservice/rest/services/Wetlands/MapServer"
USDA_SOILS_URL="https://sdmdataaccess.sc.egov.usda.gov/Tabular/post.rest"
EPA_FRS_URL="https://data.epa.gov/efservice"
USGS_EPQS_URL="https://epqs.nationalmap.gov/v1/json"
OVERPASS_URL="https://overpass-api.de/api/interpreter"

# ---- Web -------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="Land Alpha"
# Optional MapLibre style. The parcel map works without it — geometry is drawn
# as inline SVG with no tile dependency.
# NEXT_PUBLIC_MAP_STYLE_URL=""
PUBLIC_SITE_ENABLED=true

# ---- Email -----------------------------------------------------------------
EMAIL_DRIVER=console              # console | smtp
# SMTP_URL="smtp://user:pass@smtp.example.com:587"
ALERT_FROM_EMAIL="alerts@landalpha.example"

# ---- Logging ---------------------------------------------------------------
LOG_LEVEL=debug                   # debug | info | warn | error
