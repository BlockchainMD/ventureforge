{
  "name": "@land-alpha/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "build": "prisma generate",
    "generate": "prisma generate",
    "migrate": "prisma migrate deploy",
    "migrate:dev": "prisma migrate dev",
    "push": "prisma db push",
    "studio": "prisma studio",
    "reset": "prisma migrate reset --force",
    "seed": "tsx ./src/seed/run.ts"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "dependencies": {
    "@land-alpha/shared": "workspace:*",
    "@prisma/client": "^6.19.1",
    "bullmq": "^5.63.0",
    "@land-alpha/source-registry": "workspace:*"
  },
  "devDependencies": {
    "prisma": "^6.19.1",
    "tsx": "^4.20.6"
  }
}
