/// Where a recorder cannot be searched programmatically, work is queued for a
/// human rather than guessed at.
model TitleResearchTask {
  id          String    @id @default(uuid())
  parcelId    String
  taskType    String
  instructions String
  recorderUrl String?
  status      String    @default("OPEN")
  assignedTo  String?
  findings    String?
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  parcel ParcelOpportunity @relation(fields: [parcelId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([parcelId])
}

// ===========================================================================
// Seller financing
// ===========================================================================

enum FinanceNoteStatus {
  DRAFT
  ACTIVE
  PAID_OFF
  DELINQUENT
  DEFAULTED
  FORFEITED
  CANCELLED
}

enum FinancePaymentKind {
  DOWN_PAYMENT
  SCHEDULED
  EXTRA_PRINCIPAL
  PAYOFF
  LATE_FEE
  DOCUMENT_FEE
  REFUND
}

/// An executed seller-financed sale: the terms, and where the note stands.
///
/// The schedule is derived from the terms rather than stored row by row, so a
/// note cannot drift out of agreement with its own arithmetic. What is stored
/// is what actually happened — the payments.
model FinanceNote {
  id             String            @id @default(uuid())
  parcelId       String            @unique
  buyerLeadId    String?
  status         FinanceNoteStatus @default(DRAFT)

  salePrice      Decimal  @db.Decimal(14, 2)
  downPayment    Decimal  @db.Decimal(14, 2)
  /// Nominal annual rate, e.g. 0.10 for 10%.
  annualRate     Float
  termMonths     Int
  documentFee    Decimal  @db.Decimal(14, 2) @default(0)
  monthlyFee     Decimal  @db.Decimal(14, 2) @default(0)
  /// Charged when a payment is late by more than the grace period.
  lateFee        Decimal  @db.Decimal(14, 2) @default(0)
  graceDays      Int      @default(10)

  firstPaymentDate DateTime
  signedAt         DateTime?
  closedAt         DateTime?
  /// Why the note ended, when it ended other than by being paid off.
  closureReason    String?

  /// Recorded at signing so a later change to the engine cannot rewrite what
  /// was agreed. The note is a contract; the model is not.
  scheduleSnapshot Json?

  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parcel   ParcelOpportunity @relation(fields: [parcelId], references: [id], onDelete: Cascade)
  buyer    Lead?             @relation(fields: [buyerLeadId], references: [id], onDelete: SetNull)
  payments FinancePayment[]

  @@index([status])
  @@index([firstPaymentDate])
}

/// One payment actually received. The ledger, not the plan.
model FinancePayment {
  id         String             @id @default(uuid())
  noteId     String
  kind       FinancePaymentKind @default(SCHEDULED)
  amount     Decimal            @db.Decimal(14, 2)
  receivedAt DateTime
  /// Which scheduled instalment this was applied to, where it maps to one.
  appliesToPaymentNumber Int?
  method     String?
  reference  String?
  notes      String?
  recordedById String?
  createdAt  DateTime @default(now())

  note FinanceNote @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@index([noteId, receivedAt])
}

// ===========================================================================
// Deal room / due diligence
// ===========================================================================

model Deal {
  id             String   @id @default(uuid())
  parcelId       String   @unique
  openedById     String?
  openedAt       DateTime @default(now())
  targetMaxBid   Decimal? @db.Decimal(14, 2)
  approvedMaxBid Decimal? @db.Decimal(14, 2)
  approvedById   String?
  approvedAt     DateTime?
  /// Explicit human acknowledgement required before a high-value acquisition.
  dueDiligenceAcknowledgedBy String?
  dueDiligenceAcknowledgedAt DateTime?
  closedAt       DateTime?
  outcome        String?
  summary        String?
  updatedAt      DateTime @updatedAt

  parcel        ParcelOpportunity   @relation(fields: [parcelId], references: [id], onDelete: Cascade)
  checklistItems DealChecklistItem[]
  documents     DealDocument[]
  notes         DealNote[]
}

model DealChecklistItem {
  id           String    @id @default(uuid())
  dealId       String
  key          String
  label        String
  category     String
  required     Boolean   @default(true)
  ordering     Int       @default(0)
  status       String    @default("PENDING")
  completedById String?
  completedAt  DateTime?
  findings     String?

  deal        Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)
  completedBy User?  @relation(fields: [completedById], references: [id], onDelete: SetNull)

  @@unique([dealId, key])
  @@index([dealId, ordering])
}

model DealDocument {
  id           String   @id @default(uuid())
  dealId       String
  checklistKey String?
  title        String
  storageKey   String
  contentType  String?
  byteSize     Int?
  uploadedBy   String?
  createdAt    DateTime @default(now())

  deal Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([dealId])
}

model DealNote {
  id           String   @id @default(uuid())
  dealId       String
  checklistKey String?
  authorId     String?
  body         String
  createdAt    DateTime @default(now())

  deal Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([dealId, createdAt])
}

// ===========================================================================
// Portfolio
// ===========================================================================

model PortfolioAsset {
  id                String    @id @default(uuid())
  parcelId          String    @unique
  acquiredAt        DateTime
  acquisitionPrice  Decimal   @db.Decimal(14, 2)
  closingCosts      Decimal   @db.Decimal(14, 2) @default(0)
  improvementCosts  Decimal   @db.Decimal(14, 2) @default(0)
  titleCosts        Decimal   @db.Decimal(14, 2) @default(0)
  taxesPaid         Decimal   @db.Decimal(14, 2) @default(0)
  carryingCosts     Decimal   @db.Decimal(14, 2) @default(0)
  marketingCosts    Decimal   @db.Decimal(14, 2) @default(0)
  listPrice         Decimal?  @db.Decimal(14, 2)
  soldAt            DateTime?
  salePrice         Decimal?  @db.Decimal(14, 2)
  sellingCosts      Decimal   @db.Decimal(14, 2) @default(0)
  realizedProfit    Decimal?  @db.Decimal(14, 2)
  realizedRoi       Float?
  daysHeld          Int?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  parcel       ParcelOpportunity      @relation(fields: [parcelId], references: [id], onDelete: Cascade)
  transactions PortfolioTransaction[]

  @@index([soldAt])
}

model PortfolioTransaction {
  id        String   @id @default(uuid())
  assetId   String
  kind      String
  amount    Decimal  @db.Decimal(14, 2)
  occurredAt DateTime
  memo      String?
  createdBy String?
  createdAt DateTime @default(now())

  asset PortfolioAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId, occurredAt])
}

// ===========================================================================
// Listing & leads
// ===========================================================================

model Listing {
  id                String   @id @default(uuid())
  parcelId          String   @unique
  slug              String   @unique
  title             String
  shortDescription  String
  longDescription   String
  keyFeatures       String[] @default([])
  locationSummary   String
  drivingDirections String?
  nearbyAttractions String[] @default([])
  propertyFacts     Json     @default("[]")
  faq               Json     @default("[]")
  dueDiligenceDisclosure String
  seoTitle          String
  metaDescription   String
  socialCopy        String
  askingPrice       Decimal? @db.Decimal(14, 2)

  /// Seller-financing terms offered publicly on this listing.
  ///
  /// A monthly figure is the single largest conversion lever in land sales: it
  /// moves the buyer pool from people with cash to people with income. Stored
  /// on the listing rather than derived at render time so that what a buyer was
  /// shown is what was offered, even after the pricing model changes.
  financeOffered    Boolean  @default(false)
  financeDownPayment Decimal? @db.Decimal(14, 2)
  financeMonthlyPayment Decimal? @db.Decimal(14, 2)
  financeTermMonths Int?
  financeAnnualRate Float?
  financeDocumentFee Decimal? @db.Decimal(14, 2)
  published         Boolean  @default(false)
  publishedAt       DateTime?
  generatedBy       String   @default("listing-engine")
  generatorVersion  String   @default("1")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  parcel   ParcelOpportunity @relation(fields: [parcelId], references: [id], onDelete: Cascade)
  variants ListingVariant[]
  photos   ListingPhoto[]

  @@index([published])
}

model ListingVariant {
  id        String   @id @default(uuid())
  listingId String
  channel   String
  title     String
  body      String
  metadata  Json     @default("{}")
  createdAt DateTime @default(now())

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([listingId, channel])
}

model ListingPhoto {
  id         String   @id @default(uuid())
  listingId  String
  storageKey String
  caption    String?
  ordering   Int      @default(0)
  createdAt  DateTime @default(now())

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, ordering])
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  OFFER
  NEGOTIATING
  CONTRACT
  CLOSED
  LOST
}

model Lead {
  id          String     @id @default(uuid())
  parcelId    String?
  name        String
  email       String
  phone       String?
  source      String     @default("PUBLIC_SITE")
  inquiry     String?
  offerAmount Decimal?   @db.Decimal(14, 2)
  financing   String?
  status      LeadStatus @default(NEW)
  assignedTo  String?
  lastContactedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  parcel     ParcelOpportunity? @relation(fields: [parcelId], references: [id], onDelete: SetNull)
  financeNotes FinanceNote[]
  activities LeadActivity[]

  @@index([status, createdAt])
  @@index([parcelId])
  @@index([email])
}

model LeadActivity {
  id        String   @id @default(uuid())
  leadId    String
  kind      String
  body      String
  authorId  String?
  aiDrafted Boolean  @default(false)
  createdAt DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt])
}

// ===========================================================================
// Analyst tooling: searches, watchlists, alerts, memos, imports, jobs
// ===========================================================================

model SavedSearch {
  id        String   @id @default(uuid())
  userId    String
  name      String
  filters   Json
  isShared  Boolean  @default(false)
  isPinned  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
}

model Watchlist {
  id        String   @id @default(uuid())
  userId    String
  name      String
  createdAt DateTime @default(now())

  user  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  items WatchlistItem[]

  @@unique([userId, name])
}

model WatchlistItem {
  id          String   @id @default(uuid())
  watchlistId String
  parcelId    String
  note        String?
  addedAt     DateTime @default(now())

  watchlist Watchlist         @relation(fields: [watchlistId], references: [id], onDelete: Cascade)
  parcel    ParcelOpportunity @relation(fields: [parcelId], references: [id], onDelete: Cascade)

  @@unique([watchlistId, parcelId])
}

model AlertRule {
  id            String   @id @default(uuid())
  userId        String
  name          String
  filters       Json
  channels      String[] @default(["IN_APP"])
  enabled       Boolean  @default(true)
  lastEvaluatedAt DateTime?
  lastMatchAt   DateTime?
  matchCount    Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  notifications Notification[]

  @@unique([userId, name])
  @@index([enabled])
}

model Notification {
  id          String   @id @default(uuid())
  userId      String
  alertRuleId String?
  channel     String   @default("IN_APP")
  title       String
  body        String
  linkPath    String?
  parcelId    String?
  /// The change that triggered this, when one did. Deduplication keys on it
  /// rather than on the parcel, because a price drop on a parcel already
  /// notified is precisely the alert worth sending.
  parcelChangeId String?
  /// Sorting key for the analyst's queue: a sale in three days outranks a
  /// better parcel selling in three months.
  urgency     String   @default("NORMAL")
  readAt      DateTime?
  deliveredAt DateTime?
  createdAt   DateTime @default(now())

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  alertRule AlertRule? @relation(fields: [alertRuleId], references: [id], onDelete: SetNull)

  @@unique([alertRuleId, parcelChangeId])
  @@index([userId, readAt, createdAt])
  @@index([userId, urgency, createdAt])
}

model InvestmentMemo {
  id            String   @id @default(uuid())
  parcelId      String
  version       Int      @default(1)
  provider      String
  model         String
  sections      Json
  recommendation String
  recommendedMaxBid Decimal? @db.Decimal(14, 2)
  evidenceRefs  String[] @default([])
  unknowns      String[] @default([])
  generatedBy   String?
  createdAt     DateTime @default(now())

  parcel ParcelOpportunity @relation(fields: [parcelId], references: [id], onDelete: Cascade)

  @@unique([parcelId, version])
  @@index([parcelId, createdAt])
}

model ManualImport {
  id            String   @id @default(uuid())
  uploadedById  String
  sourceId      String?
  filename      String
  storageKey    String
  contentType   String?
  rowCount      Int      @default(0)
  status        String   @default("UPLOADED")
  detectedColumns String[] @default([])
  mapping       Json     @default("{}")
  createdCount  Int      @default(0)
  updatedCount  Int      @default(0)
  rejectedCount Int      @default(0)
  errors        Json     @default("[]")
  createdAt     DateTime @default(now())
  completedAt   DateTime?

  uploadedBy User @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
}

enum JobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

model Job {
  id          String    @id @default(uuid())
  type        String
  payload     Json
  status      JobStatus @default(QUEUED)
  priority    Int       @default(0)
  dedupeKey   String?
  attempts    Int       @default(0)
  maxAttempts Int       @default(3)
  runAt       DateTime  @default(now())
  startedAt   DateTime?
  finishedAt  DateTime?
  lastError   String?
  result      Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, runAt, priority(sort: Desc)])
  @@index([type, status])
  @@unique([dedupeKey])
}
