{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "incremental": false,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@land-alpha/shared": ["packages/shared/src/index.ts"],
      "@land-alpha/shared/*": ["packages/shared/src/*"],
      "@land-alpha/db": ["packages/db/src/index.ts"],
      "@land-alpha/db/*": ["packages/db/src/*"],
      "@land-alpha/gis": ["packages/gis/src/index.ts"],
      "@land-alpha/gis/*": ["packages/gis/src/*"],
      "@land-alpha/core": ["packages/core/src/index.ts"],
      "@land-alpha/core/*": ["packages/core/src/*"],
      "@land-alpha/valuation": ["packages/valuation/src/index.ts"],
      "@land-alpha/valuation/*": ["packages/valuation/src/*"],
      "@land-alpha/ingestion": ["packages/ingestion/src/index.ts"],
      "@land-alpha/ingestion/*": ["packages/ingestion/src/*"],
      "@land-alpha/ai": ["packages/ai/src/index.ts"],
      "@land-alpha/ai/*": ["packages/ai/src/*"],
      "@land-alpha/source-registry": ["packages/source-registry/src/index.ts"],
      "@land-alpha/source-registry/*": ["packages/source-registry/src/*"],
      "@land-alpha/title-research": ["packages/title-research/src/index.ts"],
      "@land-alpha/title-research/*": ["packages/title-research/src/*"],
      "@land-alpha/listing-engine": ["packages/listing-engine/src/index.ts"],
      "@land-alpha/listing-engine/*": ["packages/listing-engine/src/*"]
    }
  },
  "exclude": ["node_modules", "dist", ".next"]
}
