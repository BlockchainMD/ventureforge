# Land Alpha worker.
#
# Runs ingestion, enrichment, valuation, scoring and alert evaluation. Deployed
# separately from the web app because its workload is long-running and its
# scaling characteristics are completely different.

FROM node:22-slim AS base
ENV PNPM_HOME="/pnpm" PATH="/pnpm:$PATH"
RUN corepack enable
# openssl is required by Prisma's query engine.
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates \
  && rm -rf /var/lib/apt/lists/*
WORKDIR /app

FROM base AS deps
COPY pnpm-workspace.yaml pnpm-lock.yaml package.json ./
COPY packages/shared/package.json packages/shared/
COPY packages/db/package.json packages/db/
COPY packages/gis/package.json packages/gis/
COPY packages/core/package.json packages/core/
COPY packages/valuation/package.json packages/valuation/
COPY packages/ingestion/package.json packages/ingestion/
COPY packages/ai/package.json packages/ai/
COPY packages/source-registry/package.json packages/source-registry/
COPY packages/title-research/package.json packages/title-research/
COPY packages/listing-engine/package.json packages/listing-engine/
COPY apps/worker/package.json apps/worker/
RUN pnpm install --frozen-lockfile --filter @land-alpha/worker...

FROM base AS runtime
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/packages ./packages
COPY --from=deps /app/apps/worker/node_modules ./apps/worker/node_modules
COPY . .
RUN pnpm --filter @land-alpha/db generate

ENV NODE_ENV=production
USER node
CMD ["pnpm", "--filter", "@land-alpha/worker", "start"]
